# Base URL of the backend API. This is a Vite build-time variable — it gets
# baked into the static bundle when `npm run build` runs, so it must be set
# in Vercel's Project Settings > Environment Variables (Production) BEFORE
# triggering a build, not just in a local .env file.
# In production, point this at the deployed Railway backend's public URL
# (e.g. https://your-backend.up.railway.app) — never leave it pointing at
# localhost.
VITE_API_URL=http://localhost:3001
