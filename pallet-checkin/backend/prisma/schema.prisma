// Prisma schema for the Pantex Embalagens Industriais pallet rack check-in system.
// NOTE: shelf dimensions (locations/levels/positions) are NOT hardcoded anywhere here —
// they come entirely from Shelf.locations and the seeded Position rows.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PositionStatus {
  FREE
  OCCUPIED
  BLOCKED
}

enum MovementType {
  CHECK_IN
  CHECK_OUT
}

enum Role {
  ADMIN
  OPERATOR
}

model Shelf {
  id        String     @id @default(uuid())
  title     String
  locations Int
  positions Position[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Position {
  id          String         @id @default(uuid())
  shelfId     String
  shelf       Shelf          @relation(fields: [shelfId], references: [id])
  level       String
  number      Int
  status      PositionStatus @default(FREE)
  quantity    Int?
  orderNumber String?
  product     String?
  salesInfo   String?
  movements   Movement[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([shelfId, level, number])
}

model Movement {
  id           String       @id @default(uuid())
  positionId   String
  position     Position     @relation(fields: [positionId], references: [id])
  type         MovementType
  quantity     Int
  orderNumber  String
  product      String
  salesInfo    String
  timestamp    DateTime     @default(now())
}

// Two flat roles (ADMIN / OPERATOR) — no finer-grained permission system.
// New users default to OPERATOR (the lower-privilege role) so creating a
// user never accidentally grants admin access; ADMIN must be chosen
// explicitly. passwordHash is NEVER selected by default in any query that
// returns a User to an API response — every read explicitly lists the
// safe columns via Prisma `select`.
model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         Role     @default(OPERATOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A flat catalog used only for check-in autocomplete suggestions — the
// Produto field on a Movement/Position stays free text regardless (see
// ProductAutocomplete on the frontend), this is never a foreign key or a
// validation constraint on it. No @unique on `name`: duplicates are
// prevented at the import service layer via a case-insensitive check,
// since Postgres's plain unique index is case-sensitive.
model Product {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
}
