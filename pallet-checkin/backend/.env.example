DATABASE_URL="postgresql://pallet_checkin:pallet_checkin@localhost:5434/pallet_checkin?schema=public"

# Must be a long random string — NEVER a guessable value and NEVER this
# placeholder (the app refuses to start if it detects this exact value).
# Generate one with: openssl rand -base64 32
JWT_SECRET="REPLACE_WITH_openssl_rand_-base64_32_OUTPUT"

PORT=3000

# Comma-separated list of the real frontend origin(s) allowed by CORS.
# Never use a wildcard in production.
FRONTEND_ORIGIN="http://localhost:5174"

# Used only by prisma/seed-admin.ts to bootstrap the very first admin user
# (run manually once: npm run prisma:seed-admin). Pick a strong password — this is a
# real login for a real system. Additional users are created afterwards via
# the authenticated POST /auth/users endpoint, not via env vars.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_PASSWORD"
