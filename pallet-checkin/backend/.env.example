# Connection string for the PostgreSQL database. In production (Railway),
# use the DATABASE_URL Railway's Postgres plugin injects automatically —
# never point production at the local docker-compose database below.
DATABASE_URL="postgresql://pallet_checkin:pallet_checkin@localhost:5434/pallet_checkin?schema=public"

# Signs and verifies JWTs. Must be a long random string — NEVER a guessable
# value and NEVER this exact placeholder (the app refuses to start if it
# detects it — see backend/src/auth/jwt-secret.ts). Generate a fresh one
# for production; never reuse the value from a developer's local .env.
# Generate one with: openssl rand -base64 32
JWT_SECRET="dev-only-secret-change-me"

# Railway assigns this dynamically at runtime and injects it automatically —
# do not set it manually there. This value is only used for local dev.
PORT=3001

# Comma-separated list of the real frontend origin(s) allowed by CORS.
# Never use a wildcard in production. In production this must be the
# deployed Vercel production URL (e.g. https://your-project.vercel.app or a
# custom domain) — Vercel preview deployments get different subdomains and
# are NOT covered by a single exact value here, which is fine as long as
# only the production frontend talks to this backend.
FRONTEND_ORIGIN="http://localhost:5174"

# Set to "production" on Railway. Not read directly by application code
# today (Nest's default exception filter never leaks stack traces to
# clients regardless of this value), but it's still expected by Express/
# Nest internals and by convention for any production Node process.
NODE_ENV=development

# Used only by prisma/seed-admin.ts to bootstrap the very first admin user
# (run manually once: npm run prisma:seed-admin). Pick a strong password —
# this is a real login for a real system. Generate a fresh, unique password
# for production; never reuse a value from development. Additional users
# are created afterwards via the authenticated POST /auth/users endpoint,
# not via env vars.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_PASSWORD"

# Same as ADMIN_USERNAME/ADMIN_PASSWORD above, but bootstraps the first
# OPERATOR-role user. Also read only by prisma/seed-admin.ts. Generate a
# fresh, unique password for production; never reuse a value from
# development.
OPERATOR_USERNAME="operador"
OPERATOR_PASSWORD="REPLACE_WITH_A_STRONG_PASSWORD"

# Same as ADMIN_USERNAME/ADMIN_PASSWORD above, but bootstraps the first
# VENDEDOR-role user — a single shared, strictly read-only login (Visão
# Geral + Resumo atual only, no check-in/check-out, no exports). Optional:
# unlike ADMIN/OPERATOR above, prisma/seed-admin.ts just skips creating
# this user (with a log message) if these two vars are left unset, rather
# than failing the script. Generate a fresh, unique password for
# production; never reuse a value from development.
VENDOR_USERNAME="vendedor"
VENDOR_PASSWORD="REPLACE_WITH_A_STRONG_PASSWORD"
